{% extends 'layout.html.twig' %}

{% block title %}Connectez vous !{% endblock %}

{% block FormArmor_body %}
<div class="container"> <!-- Ajout d'un conteneur -->
    <form method="post" action="{{ path('login')}}" class="my-4">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3 p-3 bg-light rounded">
                Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>
                <form action="{{ path('app_logout') }}" method="post" class="d-inline">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="btn btn-link p-0 align-baseline">Déconnexion</button>
                </form>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Connectez-vous</h1>
        
        <div class="form-group mb-3"> <!-- Groupe de formulaire -->
            <label for="inputUsername">Nom d'utilisateur</label>
            <input type="text" value="{{ last_username }}" name="_username" id="inputUsername" 
                   class="form-control" autocomplete="username" autofocus>
        </div>

        <div class="form-group mb-3"> <!-- Groupe de formulaire -->
            <label for="inputPassword">Mot de passe</label>
            <input type="password" name="_password" id="inputPassword" 
                   class="form-control" autocomplete="current-password">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="d-flex justify-content-between align-items-center mt-4"> <!-- Conteneur flex pour les boutons -->
            <button class="btn btn-lg btn-primary" type="submit">
                Se connecter
            </button>
        </div>
    </form>
</div>
{% endblock %}