{% extends 'base.html.twig' %}
{% block title %}Creation de compte client !{% endblock %}
{% block body %}

<h3>Formulaire de saisie des clients</h3>

    <div class="well">
      {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
 
      {# Les erreurs générales du formulaire. #}
      {{ form_errors(form) }}
 
      {# Génération du label + error + widget pour un champ. #}
      {{ form_row(form.username) }}
 
      {# Génération du label + error + widget pour un champ. #}
      {{ form_row(form.password) }}
 
      {# Génération du label + error + widget pour un champ. #}
      {{ form_row(form.roles) }}
    <!-- A COMPLETER PAR LES AUTRES CHAMPS DE L'ENTITY CLIENT -->

    {{ form_row(form.adresse) }}
    {{ form_row(form.statut) }}
    {{ form_row(form.cp)}}
    {{ form_row(form.ville)}}
    {{ form_row(form.email)}}
    {% if form.nbhcpta is defined %}
    {{ form_row(form.nbhcpta) }}
{% else %}
    <div class="alert alert-warning">Warning: nbhcpta field not available</div>
{% endif %}
{% if form.nbhbur is defined %}
    {{ form_row(form.nbhbur) }}
{% else %}
    <div class="alert alert-warning">Warning: nbhbur field not available</div>
{% endif %}
{{ form_row(form.tel) }} 
    



      {# Pour le bouton, pas de label ni d'erreur, on affiche juste le widget #}
      {{ form_widget(form.enregistrer, {'attr': {'class': 'btn btn-primary'}}) }}
 
      {# Génération automatique des champs pas encore écrits.
         Dans cet exemple, ce serait le champ CSRF (géré automatiquement par Symfony !)
         et tous les champs cachés (type « hidden »). #}
      {{ form_rest(form) }}
       {# Fermeture de la balise <form> du formulaire HTML #}
      {{ form_end(form) }}
    </div>
{% endblock %}