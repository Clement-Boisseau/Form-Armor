{% extends 'layout.html.twig' %}



{% block FormArmor_body %}
	
<div id="myCarousel" class="carousel slide" data-bs-ride="carousel">
        <!-- Indicators -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="3"></button>
            <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="4"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/formation1.jpg" class="d-block w-100" alt="Image1 FormArmor">
                <div class="carousel-caption d-none d-md-block">
                    <h5>FORMARMOR</h5>
                    <p>Des formateurs à votre service.</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/formation2.jpg" class="d-block w-100" alt="Image1 FormArmor">
                <div class="carousel-caption d-none d-md-block">
                    <h5>FORMARMOR</h5>
                    <p>Un équipement de qualité et à disposition.</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/formation3.jpg" class="d-block w-100" alt="Image1 FormArmor">
                <div class="carousel-caption d-none d-md-block">
                    <h5>FORMARMOR</h5>
                    <p>De multiples formations diplomantes.</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/formation4.jpg" class="d-block w-100" alt="Image1 FormArmor">
                <div class="carousel-caption d-none d-md-block">
                    <h5>FORMARMOR</h5>
                    <p>L'accompagnement de vos projets professionnels</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/images/formation5.jpg" class="d-block w-100" alt="Image1 FormArmor">
                <div class="carousel-caption d-none d-md-block">
                    <h5>FORMARMOR</h5>
                    <p>Une formation à proximité et dans une ambiance chaleureuse.</p>
                </div>
            </div>



            
            
        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
	
{% endblock %}